DATABASE_URL=postgresql+asyncpg://feynman_app:change-me@127.0.0.1:5432/feynman
MIGRATION_DATABASE_URL=postgresql+asyncpg://feynman_migrator:change-me@127.0.0.1:5432/feynman
TEST_DATABASE_URL=postgresql+asyncpg://feynman_app:change-me@127.0.0.1:5432/feynman_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://feynman_migrator:change-me@127.0.0.1:5432/feynman_test
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# ENVIRONMENT=dev
# HEALTH_DB_TIMEOUT_SECONDS=2.0
# UPLOAD_DIR=var/uploads
# HIBP_ENABLED=true
# HIBP_TIMEOUT_SECONDS=2.0
# SESSION_COOKIE_SECURE=true  (set false for plain-http local dev)
# LOGIN_EMAIL_FAILURE_LIMIT=5
# LOGIN_IP_LIMIT=20
# LOGIN_WINDOW_SECONDS=900
# ACCOUNT_DELETE_FAILURE_LIMIT=5
# ACCOUNT_DELETE_WINDOW_SECONDS=900
# REGISTER_IP_LIMIT=5
# REGISTER_WINDOW_SECONDS=3600
# JOB_LEASE_SECONDS=300
# JOB_POLL_INTERVAL_SECONDS=1.0
# JOB_BACKOFF_BASE_SECONDS=10.0
# MAX_PDF_PAGES=200
# MIN_DOCUMENT_TEXT_CHARS=100
# MAX_UPLOAD_BYTES=20971520
# UPLOAD_MULTIPART_ALLOWANCE_BYTES=65536
# LLM (worker only). Set LLM_ENABLED=true and a real key in api/.env, never here.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
# LLM_MODEL_KNOWLEDGE_MAP=claude-sonnet-5-5
# LLM_MODEL_FLASHCARDS=claude-haiku-5-5
# LLM_EFFORT=medium  (low | medium | high)
# LLM_REQUEST_TIMEOUT_SECONDS=240.0
# LLM_JOB_LEASE_SECONDS=600  (must be >= LLM_REQUEST_TIMEOUT_SECONDS + 60)
# KNOWLEDGE_MAP_CHUNK_CHARS=120000
# KNOWLEDGE_MAP_PARALLEL_CHUNKS=4
# MAX_DOCUMENT_TEXT_CHARS=2000000
# MAP_BUILD_LIMIT=5
# CARD_GENERATION_LIMIT=20
# LLM_LIMIT_WINDOW_SECONDS=86400
